# Meta Ads Manager Lite — environment template.
# Copy to .env.local and fill in. .env* is gitignored except this file.

# ─── Supabase (this app's OWN project — not the parent app's) ──────────────
# Pooled connection (port 6543) for the app; direct (5432) for drizzle-kit.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Needed for Factory creative uploads to Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=

# ─── App secrets — generate fresh, do NOT reuse the parent app's ───────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored Meta token undecryptable — re-bootstrap after.
APP_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DEV_SETUP_TOKEN=

# ─── Meta app ──────────────────────────────────────────────────────────────
# Same Meta app as the parent — only re-register if you intend to run OAuth
# from this app, which needs the callback URL below whitelisted in Meta first.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback

# ─── Inngest ───────────────────────────────────────────────────────────────
# Powers insights sync, the bulk-launch Factory, and cross-account clone jobs.
# NO rule runners are registered here — see lib/inngest/functions.ts.
# Local dev: set INNGEST_DEV=1 and skip the keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Lite scope ────────────────────────────────────────────────────────────
# The two accounts this app manages. Comma-separated; `act_` prefix optional.
LITE_AD_ACCOUNT_IDS=act_1690421202260749,act_1386521543403841
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAILS=andi@funnelduo.com

# ─── Bootstrap only ────────────────────────────────────────────────────────
# Used once by scripts/bootstrap-lite.ts to copy the Meta token out of the
# parent AI Ads Agent database (read-only) instead of re-running OAuth.
# Alternatively set META_LONG_LIVED_TOKEN and skip these two.
PARENT_DATABASE_URL=
PARENT_APP_ENCRYPTION_KEY=
# META_LONG_LIVED_TOKEN=
# Owner account created by the bootstrap script.
LITE_OWNER_EMAIL=andi@funnelduo.com
